# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit it.

# REQUIRED — your OpenAI API key (used for the LLM extraction step).
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OPTIONAL — Pexels API key for stock-photo fallback when a video has no
# usable thumbnail. Get one free at https://www.pexels.com/api/ .
# If left blank, recipes without a thumbnail simply get no image.
PEXELS_API_KEY=

# ABUSE PREVENTION ----------------------------------------------------------
# Static shared "app key": a secret the iOS app sends as `X-App-Key` on every
# request; the backend rejects anything missing/wrong with 401. This is abuse
# deterrence for the public beta endpoint, NOT real auth. NEVER commit a real
# value (this repo is public). The SAME value must be embedded in the iOS app
# (ios/Secrets.xcconfig — gitignored). If left blank, the app-key gate is
# DISABLED (fail-open) for local dev. Generate one with: openssl rand -hex 32
APP_KEY=

# DATABASE ------------------------------------------------------------------
# When set (Railway Postgres), this is the DB connection and DB_PATH is ignored.
# Railway's Postgres plugin exposes it as DATABASE_URL automatically in prod;
# set it locally only if you want to develop against Postgres. Leave blank to
# use the local SQLite file at DB_PATH (default for dev + tests).
DATABASE_URL=

# AUTH (Stage 1) ------------------------------------------------------------
# HS256 secret for the access/refresh JWTs WE issue. MUST be a strong random
# value in production — if unset the app runs on an INSECURE dev fallback and
# warns at startup. Generate one with: openssl rand -hex 32
JWT_SECRET=
# Allowed audiences when verifying provider identity tokens (comma-separated).
# APPLE: the app's bundle id (native Sign in with Apple sets aud = bundle id),
# plus any Services ID. GOOGLE: the OAuth client id(s) used on device. A
# provider login is REJECTED if its list is empty.
APPLE_CLIENT_IDS=
GOOGLE_CLIENT_IDS=
# Access-token lifetime (minutes) and refresh-token lifetime (days).
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=60
# Brute-force bound on POST /auth/login (attempts per IP and per email, per
# window). Separate from the extraction rate limits below.
LOGIN_ATTEMPTS_PER_WINDOW=10
LOGIN_WINDOW_SECONDS=900
# Sign in with Apple token revocation (needed for account deletion, Stage 5).
# Leave blank until then.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# OPTIONAL overrides (sensible defaults if omitted) --------------------------
# LLM model for extraction (mini tier keeps cost low, per project spec).
OPENAI_MODEL=gpt-5.4-mini
# SQLite file location (used only when DATABASE_URL is blank).
DB_PATH=recipes.db
# Persistent rate limits — per user-id (spoofable X-User-Id header) and per IP
# (defense in depth), each over a minute and an hour window. Defaults are tuned
# for a small TestFlight beta: generous for real use, tight on cost abuse.
RATE_LIMIT_USER_PER_MIN=8
RATE_LIMIT_USER_PER_HOUR=40
RATE_LIMIT_IP_PER_MIN=15
RATE_LIMIT_IP_PER_HOUR=100
