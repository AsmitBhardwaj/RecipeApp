# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit it.

# REQUIRED — your OpenAI API key (used for the LLM extraction step).
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OPTIONAL — Pexels API key for stock-photo fallback when a video has no
# usable thumbnail. Get one free at https://www.pexels.com/api/ .
# If left blank, recipes without a thumbnail simply get no image.
PEXELS_API_KEY=

# ABUSE PREVENTION ----------------------------------------------------------
# Static shared "app key": a secret the iOS app sends as `X-App-Key` on every
# request; the backend rejects anything missing/wrong with 401. This is abuse
# deterrence for the public beta endpoint, NOT real auth. NEVER commit a real
# value (this repo is public). The SAME value must be embedded in the iOS app
# (ios/Secrets.xcconfig — gitignored). If left blank, the app-key gate is
# DISABLED (fail-open) for local dev. Generate one with: openssl rand -hex 32
APP_KEY=

# OPTIONAL overrides (sensible defaults if omitted) --------------------------
# LLM model for extraction (mini tier keeps cost low, per project spec).
OPENAI_MODEL=gpt-5.4-mini
# SQLite file location.
DB_PATH=recipes.db
# Persistent rate limits — per user-id (spoofable X-User-Id header) and per IP
# (defense in depth), each over a minute and an hour window. Defaults are tuned
# for a small TestFlight beta: generous for real use, tight on cost abuse.
RATE_LIMIT_USER_PER_MIN=8
RATE_LIMIT_USER_PER_HOUR=40
RATE_LIMIT_IP_PER_MIN=15
RATE_LIMIT_IP_PER_HOUR=100
