# Secrets — never commit
.env
# iOS app secret (shared app key). Commit only Secrets.example.xcconfig.
ios/Secrets.xcconfig

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/

# Local SQLite database
*.db

# OS / editor
.DS_Store
.idea/
.vscode/

# Raw ingredient photo source art — optimized copies live in
# ios/RecipeApp/Assets.xcassets/ing*.imageset; these originals aren't bundled.
/pictures/

# Sticker-generation workspace (bundled venv + large binary output) — not app code
/scripts/stickers/

# Onboarding design mockups (large PNG source art, not bundled by the build)
/onboarding/
